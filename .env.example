# =========================
# MT5 ACCOUNT
# =========================
# Leave MT5_LOGIN=0 to trade on the account already logged into the running
# MetaTrader 5 terminal (nothing is switched automatically).
MT5_LOGIN=0
MT5_PASSWORD=
MT5_SERVER=
# Optional explicit path to terminal64.exe (auto-detected when empty)
MT5_PATH=

# =========================
# TRADING
# =========================
SYMBOL=XAUUSDm

# =========================
# TELEGRAM
# =========================
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Optional additional authorized chat IDs (comma separated)
TELEGRAM_ALLOWED_CHAT_IDS=
# Push trade / error notifications to TELEGRAM_CHAT_ID
TELEGRAM_NOTIFICATIONS=true

# =========================
# DATA
# =========================
DATA_DIRECTORY=data
TRADE_LOG_FILE=trades.csv
EVENT_LOG_FILE=events.csv
ACCOUNT_LOG_FILE=account_snapshots.csv
# Telegram-controlled settings (no secrets are ever written here)
RUNTIME_SETTINGS_FILE=runtime_settings.json
# Seconds between account_snapshots.csv rows
ACCOUNT_SNAPSHOT_INTERVAL=300
# Seconds between MT5 deal-history syncs (closed-trade recording)
HISTORY_SYNC_SECONDS=15

# =========================
# RUNTIME
# =========================
# true = start trading immediately (original behaviour of the script)
# false = wait for the Telegram "START TRADING" button
AUTO_START_TRADING=true
MT5_RECONNECT_SECONDS=30

# ===========================================================================
# STRATEGY SETTINGS
# ---------------------------------------------------------------------------
# The values below are the bot's existing defaults. Leaving them untouched (or
# removing them entirely) keeps the trading behaviour exactly as it was.
# ===========================================================================

# --- Risk ---
USE_RISK_PERCENT=true
RISK_PERCENT=1.5
FIXED_LOT=0.05
MAX_OPEN_POSITIONS=4

# --- TP / RR execution layer (applied AFTER signal detection) ---
# Starting values only: these are editable live from the Telegram settings panel
# and stored in data/runtime_settings.json.
# TP_MODE: 1_pip | 2_pips | 3_pips | 4_pips | 5_pips | custom_rr
TP_MODE=custom_rr
CUSTOM_RR=3.0
# A detected signal is rejected when its reward/risk lands below MIN_RR
MIN_RR=1.0
# 1 pip = N points; 0 = derive from the symbol's digits/point
PIP_POINTS=0
# SL_MODE: structural (original behaviour) | fixed
SL_MODE=structural
SL_FIXED_POINTS=400

# --- Stops ---
USE_STRUCTURAL_SL=true
SL_POINTS_MIN=400
SL_POINTS_MAX=1000
RR=3.0

# --- Filters ---
MAX_SPREAD_POINTS=500
SESSION_FILTER=false
VOLUME_FILTER=false
MIN_CANDLE_RANGE_POINTS=25

# --- Trade management ---
MOVE_TO_BREAKEVEN_AT_R=0.5
PARTIAL_CLOSE_AT_R=1.5
PARTIAL_CLOSE_FRACTION=0.3
COOLDOWN_MINUTES=0

# --- Engine ---
MAGIC=88001199
DEVIATION_POINTS=150
M1_BARS=600
M5_BARS=300
POLL_SECONDS=0.5

# --- Pattern detection ---
SWEEP_LOOKBACK=6
SWEEP_BUFFER_POINTS=3
REJECTION_MIN_WICK_FRAC=0.15
M5_BIAS_STRICT=false
REQUIRE_ENGULF=false

DIAGNOSTICS=true
