# ===========================================================================
# MT5 ACCOUNT
# ===========================================================================
# Leave MT5_LOGIN=0 to trade on the account already logged into the running
# MetaTrader 5 terminal (nothing is switched automatically).
MT5_LOGIN=0
MT5_PASSWORD=
MT5_SERVER=
# Optional explicit path to terminal64.exe (auto-detected when empty)
MT5_PATH=

# ===========================================================================
# MARKET
# ===========================================================================
SYMBOL=XAUUSD
TIMEFRAME=M5

# ===========================================================================
# TRADING MODE
# ===========================================================================
# PAPER = ladder is calculated and filled against live ticks, nothing is sent
#         to the broker. LIVE = real pending orders.
TRADING_MODE=PAPER
PAPER_START_BALANCE=10000

# ===========================================================================
# ROLLING LADDER
# ===========================================================================
# Distance between levels, in price units (0.30 = 30 cents on gold)
LADDER_SPACING=0.30
# Levels kept live per side
LADDER_DEPTH=5
# Distance from price to the nearest level; the broker's minimum stop
# distance always wins when it is larger
FIRST_LEVEL_OFFSET=0.30
# extend = ladder rolls forward with price | static = grid fixed for the cycle
ROLL_MODE=extend
# Allow a level to be re-armed after its trade closed (rolling repeat)
REARM_LEVELS=true

# ===========================================================================
# TAKE PROFIT / STOP LOSS
# ===========================================================================
# none (default) = NO individual take profit. A triggered level is one leg of
# the cycle's BASKET, not a trade with its own target: nothing closes until the
# exit engine closes the whole cycle. This is the strategy.
# The other modes turn every level back into an independent trade:
#   levels = TP_LEVELS x LADDER_SPACING | distance = TP_DISTANCE price units |
#   1_pip..5_pips = symbol-aware pips
TP_MODE=none
TP_LEVELS=1
TP_DISTANCE=0.30
# 0 = no stop loss on ladder orders
STOP_LOSS_DISTANCE=0
# 1 pip = N points; 0 = derive from the symbol's digits/point
PIP_POINTS=0

# ===========================================================================
# ADAPTIVE EXIT (replaces any trade-count or dollar target)
# ===========================================================================
# A cycle ends when the exit engine reads reversal or exhaustion in the trigger
# sequence, or when a risk limit forces it. There is deliberately no
# "close after N trades" and no "close at $X".
# Close whatever is still open when the cycle ends. Leave this true: under the
# basket architecture nothing closes on its own, and only one cycle may be
# active at a time, so positions left running hold the next ladder back.
CYCLE_CLOSE_POSITIONS=true
# Score (0-100) at which a cycle closes, and where it starts being watched
EXIT_THRESHOLD_EXIT=70
EXIT_THRESHOLD_MONITOR=40
# Weights of each input. These are starting values to be fitted against
# historical XAUUSD data - not discovered truth.
EXIT_W_REVERSAL=0.75
EXIT_W_EXHAUSTION=0.45
# Scenario 1 (a clean directional run that has paid) and scenario 3 (an
# extended ladder that has stopped paying)
EXIT_W_DIRECTIONAL=0.65
EXIT_W_EXTENDED=0.50
EXIT_W_CONTINUATION=0.45
EXIT_W_DEPTH=0.20
EXIT_W_DRAWDOWN=0.25
EXIT_W_HARVEST=0.30
EXIT_W_LOSS_HOLD=0.20
# Normalisers: what counts as a full run, a fully extended ladder, brisk
# triggering, and how much recent history the readings use
EXIT_CONSECUTIVE_NORM=4
EXIT_DEPTH_NORM=6
EXIT_GAP_REFERENCE=60
EXIT_RECENT_WINDOW=5
EXIT_PROGRESS_INTERVALS=2
EXIT_MIN_TRIGGERS_FOR_REVERSAL=2
EXIT_MIN_TRIGGERS_FOR_EXHAUSTION=3
EXIT_MIN_TRIGGERS_FOR_DIRECTIONAL=3
EXIT_MIN_TRIGGERS_FOR_EXTENDED=5

# --- profit fallback -------------------------------------------------------
# A basket that has recovered into confirmed profit is taken rather than held
# for a scenario that may never come. This is NOT a dollar target: the buffer
# is a FRACTION OF ONE LADDER LEVEL, so it scales with lot size and spacing,
# and the profit has to hold for the confirmation period first.
PROFIT_FALLBACK_ENABLED=true
PROFIT_FALLBACK_BUFFER_LEVELS=0.5
PROFIT_CONFIRMATION_SECONDS=60
# A run still reading as continuing at or above this is never cut short for it
PROFIT_FALLBACK_CONTINUATION_GUARD=0.60

# ===========================================================================
# RISK (fixed lots - never martingale)
# ===========================================================================
LOT_SIZE=0.01
MAX_LOT_SIZE=0.10
# The basket accumulates - with no individual TP nothing closes until the whole
# cycle does - so this must allow a full ladder, not cap it at a trade count
MAX_OPEN_POSITIONS=12
MAX_PENDING_ORDERS=10
# Levels a single cycle may consume before new entries stop
MAX_LADDER_DEPTH=12
# Price units (0 = spread filter off)
MAX_SPREAD=0.50
# Deviation in points
MAX_SLIPPAGE=20
# Round-turn commission per lot, used by paper and replay costing
COMMISSION_PER_LOT=0
# Drawdown guards in account currency (0 = off). These are loss guards - the
# only place a money figure ends a cycle.
MAX_DAILY_DRAWDOWN=50
MAX_CYCLE_DRAWDOWN=20
MAX_CONSECUTIVE_LOSING_CYCLES=3
# Minutes a single cycle may stay open before risk closes it regardless of what
# the strategy thinks (0 = off, and then a cycle CAN stay open forever)
MAX_CYCLE_DURATION=120
# Minutes. This applies only to a RISK-forced close, on top of the ordinary
# re-entry cooldown below.
COOLDOWN_AFTER_LOSS=15
# Seconds. Mandatory settle time AFTER a cycle has completely exited and the
# account is verified flat, BEFORE the next ladder is built. It is not a delay
# between ladder levels, triggers or orders - the ladder runs at full speed
# inside an active cycle. 0 = re-enter immediately.
CYCLE_REENTRY_COOLDOWN=10

# ===========================================================================
# ORDER HYGIENE
# ===========================================================================
# Cancel and recalculate pending orders older than this (seconds, 0 = off)
ORDER_MAX_AGE=900
# Re-anchor the ladder at every new candle close
M5_CANDLE_RESET=false

# ===========================================================================
# DIRECTION FILTER (hook for a future model - disabled by default)
# ===========================================================================
# off | both | buy_bias | sell_bias | none
DIRECTION_FILTER=off

# ===========================================================================
# TELEGRAM
# ===========================================================================
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Optional additional authorized chat IDs (comma separated)
TELEGRAM_ALLOWED_CHAT_IDS=
TELEGRAM_NOTIFICATIONS=true
# Telegram carries important events only: cycle results, state transitions,
# risk and errors. Everything else goes to the CSV logs.
# Per-entry pings would flood the chat on this strategy - off by design.
TELEGRAM_ENTRY_ALERTS=false
# One message per NORMAL -> REVERSAL (or strong continuation) transition
TELEGRAM_STATE_ALERTS=true
# Periodic compact heartbeat
TELEGRAM_STATUS_UPDATES=true
TELEGRAM_STATUS_INTERVAL=20
# An identical error is not repeated inside this window (seconds)
TELEGRAM_ERROR_THROTTLE=300

# ===========================================================================
# DATA
# ===========================================================================
DATA_DIRECTORY=data
TRADE_LOG_FILE=trades.csv
EVENT_LOG_FILE=events.csv
ACCOUNT_LOG_FILE=account_snapshots.csv
LADDER_LOG_FILE=rolling_ladder_events.csv
CYCLE_LOG_FILE=rolling_ladder_cycles.csv
RUNTIME_SETTINGS_FILE=runtime_settings.json
LADDER_STATE_FILE=ladder_state.json
PAPER_STATE_FILE=paper_state.json
ACCOUNT_SNAPSHOT_INTERVAL=300

# ===========================================================================
# ENGINE
# ===========================================================================
MAGIC=88001199
POLL_SECONDS=0.5
DIAGNOSTICS=true
AUTO_START_TRADING=true
MT5_RECONNECT_SECONDS=30
