# ===========================================================================
# MT5 ACCOUNT
# ===========================================================================
# Leave MT5_LOGIN=0 to trade on the account already logged into the running
# MetaTrader 5 terminal (nothing is switched automatically).
MT5_LOGIN=0
MT5_PASSWORD=
MT5_SERVER=
# Optional explicit path to terminal64.exe (auto-detected when empty)
MT5_PATH=

# ===========================================================================
# MARKET
# ===========================================================================
SYMBOL=XAUUSD
TIMEFRAME=M5

# ===========================================================================
# TRADING MODE
# ===========================================================================
# PAPER = ladder is calculated and filled against live ticks, nothing is sent
#         to the broker. LIVE = real pending orders.
TRADING_MODE=PAPER
PAPER_START_BALANCE=10000

# ===========================================================================
# ROLLING LADDER
# ===========================================================================
# Distance between levels, in price units (0.30 = 30 cents on gold)
LADDER_SPACING=0.30
# Levels kept live per side
# Levels per side: one ladder is 11 BUY STOP + 11 SELL STOP = 22 orders,
# placed once when the cycle starts and never replenished.
LADDER_DEPTH=11
# Distance from price to the nearest level; the broker's minimum stop
# distance always wins when it is larger
FIRST_LEVEL_OFFSET=0.30
# static = the ladder is pinned when the cycle starts and price consumes it:
#          22 orders placed once, never replenished. This is the lifecycle the
#          bot is built around - ONE ladder per cycle.
# extend  = the window rolls forward and consumed levels are replaced, so a
#          live ladder keeps placing new orders all cycle.
ROLL_MODE=static
# Re-arm a level whose position closed. false = consumed stays consumed.
REARM_LEVELS=false

# ===========================================================================
# EXIT / STOP LOSS
# ===========================================================================
# The ONE normal strategy exit, in account currency. When the current cycle's
# TOTAL floating basket P/L reaches this, every position and every pending
# order of the cycle is closed. There are NO individual take profits: a
# triggered level is one leg of the basket, not a trade of its own.
# 0 disables the normal exit, leaving only the hard risk limits below.
BASKET_PROFIT_TARGET=2.00
# With the runner ON a basket is allowed PAST the target instead of being cut
# off at it, and the accumulated profit is trailed instead. OFF restores the
# plain "close at the target" behaviour.
PROFIT_RUNNER_ENABLED=true
# Peak floating P/L at which profit protection turns on for the cycle. Once on
# it stays on, even if the basket falls back below this.
PROFIT_PROTECTION_ACTIVATION=3.00
# How much give-back from the peak is tolerated before the basket is taken.
# This is what stops a +95 basket becoming a -9 one.
PROFIT_PROTECTION_TRAIL=1.50
# The protected floor: a basket that has been in profit is never knowingly let
# through this on the way down. Capped at BASKET_PROFIT_TARGET.
MIN_PROTECTED_PROFIT=1.00
# Close whatever is still open when the cycle ends. Leave this true: only one
# cycle may be active at a time, so positions left running hold the next ladder
# back until they close on their own.
CYCLE_CLOSE_POSITIONS=true
# Emergency stop loss per position in price units (0 = off). This is risk
# protection, not a strategy exit.
STOP_LOSS_DISTANCE=0
# 1 pip = N points; 0 derives it from the symbol's digits/point
PIP_POINTS=0

# ===========================================================================
# RISK (fixed lots - never martingale)
# ===========================================================================
LOT_SIZE=0.01
MAX_LOT_SIZE=0.10
# The basket accumulates - with no individual TP nothing closes until the whole
# cycle does - so this must allow a full ladder, not cap it at a trade count
MAX_OPEN_POSITIONS=22
# Must allow a whole ladder (2 x LADDER_DEPTH) or it deploys short
MAX_PENDING_ORDERS=22
# Levels a single cycle may consume before new entries stop
MAX_LADDER_DEPTH=22
# Price units (0 = spread filter off)
MAX_SPREAD=0.50
# Deviation in points
MAX_SLIPPAGE=20
# Round-turn commission per lot, used by paper and replay costing
COMMISSION_PER_LOT=0
# Drawdown guards in account currency (0 = off). These are loss guards - the
# only place a money figure ends a cycle.
MAX_DAILY_DRAWDOWN=50
MAX_CYCLE_DRAWDOWN=20
MAX_CONSECUTIVE_LOSING_CYCLES=3
# Minutes a single cycle may stay open before risk closes it regardless of what
# the strategy thinks (0 = off, and then a cycle CAN stay open forever)
MAX_CYCLE_DURATION=120
# Minutes. This applies only to a RISK-forced close, on top of the ordinary
# re-entry cooldown below.
COOLDOWN_AFTER_LOSS=15
# Seconds. Mandatory settle time AFTER a cycle has completely exited and the
# account is verified flat, BEFORE the next ladder is built. It is not a delay
# between ladder levels, triggers or orders - the ladder runs at full speed
# inside an active cycle. 0 = re-enter immediately.
CYCLE_REENTRY_COOLDOWN=10

# ===========================================================================
# ORDER HYGIENE
# ===========================================================================
# Cancel and recalculate pending orders older than this (seconds, 0 = off)
ORDER_MAX_AGE=900
# Re-anchor the ladder at every new candle close
M5_CANDLE_RESET=false

# ===========================================================================
# DIRECTION FILTER (hook for a future model - disabled by default)
# ===========================================================================
# off | both | buy_bias | sell_bias | none
DIRECTION_FILTER=off

# ===========================================================================
# TELEGRAM
# ===========================================================================
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Optional additional authorized chat IDs (comma separated)
TELEGRAM_ALLOWED_CHAT_IDS=
TELEGRAM_NOTIFICATIONS=true
# Telegram carries important events only: cycle results, state transitions,
# risk and errors. Everything else goes to the CSV logs.
# Per-entry pings would flood the chat on this strategy - off by design.
# Periodic compact heartbeat
TELEGRAM_STATUS_UPDATES=true
TELEGRAM_STATUS_INTERVAL=20
# An identical error is not repeated inside this window (seconds)
TELEGRAM_ERROR_THROTTLE=300

# ===========================================================================
# DATA
# ===========================================================================
DATA_DIRECTORY=data
TRADE_LOG_FILE=trades.csv
EVENT_LOG_FILE=events.csv
ACCOUNT_LOG_FILE=account_snapshots.csv
LADDER_LOG_FILE=rolling_ladder_events.csv
CYCLE_LOG_FILE=rolling_ladder_cycles.csv
RUNTIME_SETTINGS_FILE=runtime_settings.json
LADDER_STATE_FILE=ladder_state.json
PAPER_STATE_FILE=paper_state.json
# Seconds between intra-cycle basket snapshots in basket_telemetry.csv, the
# record the exit rules are meant to be optimised against. CSV only, never
# Telegram. 0 = off.
TELEMETRY_INTERVAL_SECONDS=2
ACCOUNT_SNAPSHOT_INTERVAL=300

# ===========================================================================
# ENGINE
# ===========================================================================
MAGIC=88001199
POLL_SECONDS=0.5
DIAGNOSTICS=true
AUTO_START_TRADING=true
MT5_RECONNECT_SECONDS=30
