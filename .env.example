# ===========================================================================
# MT5 ACCOUNT
# ===========================================================================
# Leave MT5_LOGIN=0 to trade on the account already logged into the running
# MetaTrader 5 terminal (nothing is switched automatically).
MT5_LOGIN=0
MT5_PASSWORD=
MT5_SERVER=
# Optional explicit path to terminal64.exe (auto-detected when empty)
MT5_PATH=

# ===========================================================================
# MARKET
# ===========================================================================
SYMBOL=XAUUSD
TIMEFRAME=M5
# The candle whose CLOSE may start a NEW cycle. A new cycle is evaluated once
# per newly closed candle on this timeframe - never on the forming candle and
# never on a bare tick. It decides WHEN a cycle may begin; it does not touch
# the ladder, the spacing or the exit. M1 or M5 in practice.
ENTRY_TIMEFRAME=M1

# ===========================================================================
# TRADING MODE
# ===========================================================================
# PAPER = ladder is calculated and filled against live ticks, nothing is sent
#         to the broker. LIVE = real pending orders.
TRADING_MODE=PAPER
PAPER_START_BALANCE=10000

# ===========================================================================
# ROLLING LADDER
# ===========================================================================
# Distance between levels, in price units (0.30 = 30 cents on gold)
LADDER_SPACING=0.30
# Levels kept live per side
# Levels per side: one ladder is 11 BUY STOP + 11 SELL STOP = 22 orders,
# placed once when the cycle starts and never replenished.
LADDER_DEPTH=11
# EXTRA standoff between the market and a NEW level, on top of the broker's own
# minimum stop distance. 0 = the intended geometry stands and the first level
# sits exactly one LADDER_SPACING from the reference price.
# This never MOVES a level: it only decides whether one may be placed yet.
# Setting it to 0.30 (the old default) is what pushed the first level out to
# +0.60, because the standoff was measured from the market and then rounded
# onto the grid.
FIRST_LEVEL_OFFSET=0.0
# static = the ladder is pinned when the cycle starts and price consumes it:
#          22 orders placed once, never replenished. This is the lifecycle the
#          bot is built around - ONE ladder per cycle.
# extend  = the window rolls forward and consumed levels are replaced, so a
#          live ladder keeps placing new orders all cycle.
ROLL_MODE=static

# How a cycle's ladder is laid out.
#   FULL_LADDER - LADDER_DEPTH levels per side, all placed when the cycle
#                 starts (11 + 11 = 22 orders). This is the shipped default.
#   SINGLE_PAIR - ONE buy stop and ONE sell stop. When a level triggers, the
#                 next level on that side goes out immediately, so there is
#                 never more than one pending order per side.
# Both use the same reference price, the same 0.30 geometry, the same exit
# engine, the same risk controls and the same lot size. The only difference is
# how many levels are pending at once.
#   STEPPED_STRADDLE - ONE buy stop and ONE sell stop, STEP_DISTANCE either
#                 side of the reference. One fills, the other is cancelled,
#                 and the single position is managed by a stepped stop loss.
#                 No basket, no recovery, no profit target, no expansion.
ENTRY_MODE=FULL_LADDER

# --- STEPPED_STRADDLE ------------------------------------------------------
# Five INDEPENDENT distances, all XAUUSD PRICE UNITS - 0.50 means fifty cents
# of gold, never a broker pip and never points.
#   Reference 4500.00 gives BUY STOP 4501.00 (SL 4500.50)
#                       and SELL STOP 4499.00 (SL 4499.50)
# INITIAL TEST DEFAULTS - fitted to nothing.
ENTRY_OFFSET=1.00
INITIAL_SL_DISTANCE=0.50
# Favourable move that frees the trade, then where the stop goes
# (0.00 = exactly breakeven).
BREAKEVEN_TRIGGER=0.50
BREAKEVEN_OFFSET=0.00
# Favourable move that arms the trail, and how far behind the best price SEEN
# the stop then rides. The trail is CONTINUOUS - every new extreme drags the
# stop with it and a pullback moves it nowhere.
# Must be GREATER than the broker's minimum stop distance or the trail can
# never be accepted; the bot logs STRADDLE_TRAIL_UNREACHABLE if it is not.
TRAIL_TRIGGER=1.00
TRAIL_DISTANCE=0.50
CANCEL_OPPOSITE_ON_FILL=true
# M1 gating applies ONLY to starting a new cycle. Trailing is always live.
USE_NEW_M1_CANDLE_ENTRY=true
# Re-arm a level whose position closed. false = consumed stays consumed.
REARM_LEVELS=false

# ===========================================================================
# EXIT / STOP LOSS
# ===========================================================================
# The ONE normal strategy exit, in account currency. When the current cycle's
# TOTAL floating basket P/L reaches this, every position and every pending
# order of the cycle is closed. There are NO individual take profits: a
# triggered level is one leg of the basket, not a trade of its own.
# 0 disables the normal exit, leaving only the hard risk limits below.
BASKET_PROFIT_TARGET=2.00
# With the runner ON a basket is allowed PAST the target instead of being cut
# off at it, and the accumulated profit is trailed instead. OFF restores the
# plain "close at the target" behaviour.
PROFIT_RUNNER_ENABLED=true
# Peak floating P/L at which profit protection turns on for the cycle. Once on
# it stays on, even if the basket falls back below this.
PROFIT_PROTECTION_ACTIVATION=3.00
# How much give-back from the peak is tolerated before the basket is taken.
# This is what stops a +95 basket becoming a -9 one.
PROFIT_PROTECTION_TRAIL=1.50
# The protected floor: a basket that has been in profit is never knowingly let
# through this on the way down. Capped at BASKET_PROFIT_TARGET.
MIN_PROTECTED_PROFIT=1.00

# --- basket state engine ---------------------------------------------------
# NONE of these are validated. They are explainable starting points, not
# optimal values, and exist to be fitted once there is enough telemetry.
# How far under water counts as meaningfully negative rather than noise
UNDERWATER_THRESHOLD=2.00
# Fraction of the hole that must be climbed back to count as a recovery
RECOVERY_FRACTION=0.50
# A recovered basket is taken at this profit rather than the full target
RECOVERY_TAKE_PROFIT=0.50
# Give-back allowed from a peak that reached the target but never reached
# PROFIT_PROTECTION_ACTIVATION, as a fraction of that peak. Without this there
# is a dead band between the two in which nothing defends the profit.
PROFIT_GIVEBACK_FRACTION=0.40
# Seconds of price history behind the favorable/adverse movement reading
PRICE_MOVEMENT_WINDOW=20

# --- exposure limits -------------------------------------------------------
# ABSOLUTE depths at which each ladder zone begins. Absolute, not fractions of
# MAX_LADDER_DEPTH: "12 levels deep" is a fact about the exposure and should
# not change meaning because someone raised the ceiling.
#
# A deep ladder is NOT automatically a bad ladder - deep baskets do recover.
# The ZONE decides how much more exposure may be added; basket HEALTH decides
# whether to exit. Depth on its own never closes anything.
# INITIAL TEST DEFAULTS - fitted to nothing, expect to change them with data.
LADDER_EXTENDED_DEPTH=9
LADDER_DEEP_DEPTH=12
LADDER_CRITICAL_DEPTH=16

# false = the zones are still recorded, but never gate expansion
DEEP_LADDER_RISK_ENABLED=true
# Drawdown from peak (account currency) counting as a large hole for a deep
# basket. INITIAL TEST DEFAULT.
DEEP_LADDER_MAX_DRAWDOWN=10.00
# Imbalance above which a deep basket is dangerously one-sided.
DEEP_LADDER_MAX_IMBALANCE=0.60
# Seconds a deep basket may sit underwater without a meaningful recovery before
# that counts against it.
DEEP_LADDER_RECOVERY_TIMEOUT=900
# Adverse movement (price units, over PRICE_MOVEMENT_WINDOW) counting as "still
# going the wrong way" rather than noise.
DEEP_LADDER_ADVERSE_MOVEMENT=0.60
# |buy_volume - sell_volume| / gross_volume above which a basket counts as
# one-sided. Measured on VOLUME: BUY 11x0.01 against SELL 1x0.11 is balanced,
# even though the order counts say 11-to-1.
MAX_DIRECTION_IMBALANCE=0.80
# MONITOR = record it only (the default while we collect data).
# STOP_NEW_EXPOSURE = also stop adding levels. Neither closes the basket, and
# neither ever adds the other side to "balance" it - that would be martingale.
IMBALANCE_ACTION=MONITOR
# Legs required before the imbalance ratio means anything - one leg is
# trivially 100% one-sided.
IMBALANCE_MIN_POSITIONS=4

# --- recovery quality ------------------------------------------------------
# Fractions of the hole climbed back that grade the recovery WEAK / STRONG.
WEAK_RECOVERY_FRACTION=0.25
STRONG_RECOVERY_FRACTION=0.75
# Close whatever is still open when the cycle ends. Leave this true: only one
# cycle may be active at a time, so positions left running hold the next ladder
# back until they close on their own.
CYCLE_CLOSE_POSITIONS=true
# Emergency stop loss per position in price units (0 = off). This is risk
# protection, not a strategy exit.
STOP_LOSS_DISTANCE=0
# 1 pip = N points; 0 derives it from the symbol's digits/point
PIP_POINTS=0

# ===========================================================================
# RISK (fixed lots - never martingale)
# ===========================================================================
LOT_SIZE=0.01
MAX_LOT_SIZE=0.10
# The basket accumulates - with no individual TP nothing closes until the whole
# cycle does - so this must allow a full ladder, not cap it at a trade count
MAX_OPEN_POSITIONS=22
# Must allow a whole ladder (2 x LADDER_DEPTH) or it deploys short
MAX_PENDING_ORDERS=22
# Levels a single cycle may consume before new entries stop
MAX_LADDER_DEPTH=22
# Price units (0 = spread filter off)
MAX_SPREAD=0.50
# Deviation in points
MAX_SLIPPAGE=20
# Round-turn commission per lot, used by paper and replay costing
COMMISSION_PER_LOT=0
# Drawdown guards in account currency (0 = off). These are loss guards - the
# only place a money figure ends a cycle.
MAX_DAILY_DRAWDOWN=50
MAX_CYCLE_DRAWDOWN=20
MAX_CONSECUTIVE_LOSING_CYCLES=3
# Minutes a single cycle may stay open before risk closes it regardless of what
# the strategy thinks (0 = off, and then a cycle CAN stay open forever)
MAX_CYCLE_DURATION=120
# Minutes. This applies only to a RISK-forced close, on top of the ordinary
# re-entry cooldown below.
COOLDOWN_AFTER_LOSS=15
# Seconds. Mandatory settle time AFTER a cycle has completely exited and the
# account is verified flat, BEFORE the next ladder is built. It is not a delay
# between ladder levels, triggers or orders - the ladder runs at full speed
# inside an active cycle. 0 = re-enter immediately.
CYCLE_REENTRY_COOLDOWN=10

# ===========================================================================
# ORDER HYGIENE
# ===========================================================================
# Cancel and recalculate pending orders older than this (seconds, 0 = off)
ORDER_MAX_AGE=900
# Re-anchor the ladder at every new candle close
M5_CANDLE_RESET=false

# ===========================================================================
# DIRECTION FILTER (hook for a future model - disabled by default)
# ===========================================================================
# off | both | buy_bias | sell_bias | none
DIRECTION_FILTER=off

# ===========================================================================
# TELEGRAM
# ===========================================================================
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Optional additional authorized chat IDs (comma separated)
TELEGRAM_ALLOWED_CHAT_IDS=
TELEGRAM_NOTIFICATIONS=true
# Telegram carries important events only: cycle results, state transitions,
# risk and errors. Everything else goes to the CSV logs.
# Per-entry pings would flood the chat on this strategy - off by design.
# Periodic compact heartbeat
TELEGRAM_STATUS_UPDATES=true
TELEGRAM_STATUS_INTERVAL=20
# An identical error is not repeated inside this window (seconds)
TELEGRAM_ERROR_THROTTLE=300

# ===========================================================================
# DATA
# ===========================================================================
DATA_DIRECTORY=data
TRADE_LOG_FILE=trades.csv
EVENT_LOG_FILE=events.csv
ACCOUNT_LOG_FILE=account_snapshots.csv
LADDER_LOG_FILE=rolling_ladder_events.csv
CYCLE_LOG_FILE=rolling_ladder_cycles.csv
TELEMETRY_FILE=basket_telemetry.csv
# Every entry candle evaluated, accepted or rejected, with the reason - so
# accepted and rejected candles can be compared after the fact
ENTRY_LOG_FILE=entry_evaluations.csv
RUNTIME_SETTINGS_FILE=runtime_settings.json
LADDER_STATE_FILE=ladder_state.json
PAPER_STATE_FILE=paper_state.json
# Seconds between intra-cycle basket snapshots in basket_telemetry.csv, the
# record the exit rules are meant to be optimised against. CSV only, never
# Telegram. 0 = off.
TELEMETRY_INTERVAL_SECONDS=2
ACCOUNT_SNAPSHOT_INTERVAL=300

# ===========================================================================
# ENGINE
# ===========================================================================
MAGIC=88001199
POLL_SECONDS=0.5
# How often the basket exit monitor re-checks live P/L, on its own thread.
# Two MT5 reads and a decision - nothing else. This is the highest priority
# loop in the bot and must be faster than POLL_SECONDS.
EXIT_POLL_SECONDS=0.05
DIAGNOSTICS=true
AUTO_START_TRADING=true
MT5_RECONNECT_SECONDS=30
